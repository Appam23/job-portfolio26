---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Contact | Leihaopam Leisan"
    description="Contact Leihaopam Leisan about web development roles and projects."
>
    <section class="contact-page">
        <a class="text-link" href="/">← Back to Home</a>

        <p class="eyebrow">LET’S CONNECT</p>
        <h1>Contact Me</h1>

        <p class="contact-intro">
            Have a role, project, or question in mind?
            Send me a message using the form below.
        </p>

        <form
            id="contact-form"
            action="https://formspree.io/f/xoevzbyv"
            method="POST"
        >
            <label for="name">Name (required)</label>
            <input
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                required
            />

            <label for="email">Email (required)</label>
            <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
            />

            <label for="reason">Reason for contacting me</label>
            <select id="reason" name="reason">
                <option value="job">Job opportunity</option>
                <option value="internship">Internship</option>
                <option value="project">Project or collaboration</option>
                <option value="other">Other</option>
            </select>

            <label for="message">Message (required)</label>
            <textarea
                id="message"
                name="message"
                rows="6"
                required
            ></textarea>

            <input
                type="hidden"
                name="_subject"
                value="New job portfolio inquiry"
            />

            <button class="button button-primary" type="submit">
                Send Message →
            </button>
        </form>

        <p id="form-status" role="status" aria-live="polite"></p>

        <p class="email-option">
            Prefer email?
            <a href="mailto:appamleisan@gmail.com">
                appamleisan@gmail.com
            </a>
        </p>
    </section>
</Layout>

<script>
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    const status = document.querySelector<HTMLParagraphElement>("#form-status");

    form?.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!status) return;

        const button = form.querySelector<HTMLButtonElement>(
            'button[type="submit"]'
        );

        const formData = new FormData(form);

        if (button) {
            button.disabled = true;
            button.textContent = "Sending...";
        }

        form.setAttribute("aria-busy", "true");
        status.textContent = "Sending your message...";

        try {
            const response = await fetch(form.action, {
                method: "POST",
                body: formData,
                headers: {
                    Accept: "application/json",
                },
            });

            if (!response.ok) {
                throw new Error("Submission failed");
            }

            form.reset();
            status.textContent = "Thank you! Your message has been sent.";
        } catch {
            status.textContent =
                "Your message could not be sent. Please try again or use the email link below.";
        } finally {
            form.removeAttribute("aria-busy");

            if (button) {
                button.disabled = false;
                button.textContent = "Send Message →";
            }
        }
    });
</script>

<style>
    .contact-page {
        max-width: 680px;
        margin: 0 auto;
        padding-block: 32px;
    }

    .contact-page > .text-link {
        display: inline-block;
        margin-bottom: 32px;
    }

    .contact-page h1 {
        font-size: clamp(2.5rem, 5vw, 3.5rem);
    }

    .contact-intro,
    .email-option {
        color: var(--muted);
    }

    #contact-form {
        display: grid;
        gap: 12px;
        margin-top: 28px;
    }

    label {
        margin-top: 8px;
        font-weight: bold;
    }

    input,
    textarea,
    select {
        width: 100%;
        min-width: 0;
        padding: 12px 14px;
        border: 1px solid #78839b;
        border-radius: 8px;
        background: var(--surface);
        color: var(--text);
        font: inherit;
    }

    input,
    select {
        min-height: 48px;
    }

    textarea {
        resize: vertical;
    }

    input:focus-visible,
    textarea:focus-visible,
    select:focus-visible,
    button:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 3px;
    }

    button {
        justify-self: start;
        margin-top: 16px;
        font: inherit;
        font-weight: bold;
        cursor: pointer;
    }

    button:disabled {
        background: #536078;
        border-color: #536078;
        cursor: wait;
    }

    #form-status {
        margin-top: 20px;
        font-weight: bold;
    }

    #form-status:empty {
        margin: 0;
    }

    .email-option {
        margin-top: 24px;
        overflow-wrap: anywhere;
    }

    @media (max-width: 650px) {
        button {
            justify-self: stretch;
        }
    }
</style>