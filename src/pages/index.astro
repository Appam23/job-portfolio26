<script>
    const description =
        document.querySelector<HTMLParagraphElement>(".hero-description");

    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
    ).matches;

    if (description && !reduceMotion) {
        const text = description.textContent?.replace(/\s+/g, " ").trim() ?? "";

        // Keep the full description available to screen readers.
        const accessibleText = document.createElement("span");
        accessibleText.className = "typing-accessible";
        accessibleText.textContent = text;

        const animatedText = document.createElement("span");
        animatedText.setAttribute("aria-hidden", "true");

        // Reserve space so the page doesn't shift while typing.
        description.style.minHeight = `${description.offsetHeight}px`;
        description.replaceChildren(accessibleText, animatedText);

        const letters = Array.from(text);
        let position = 0;

        function typeLetter() {
            animatedText.textContent += letters[position];
            position++;

            if (position < letters.length) {
                window.setTimeout(typeLetter, 20);
            } else {
                description!.style.minHeight = "";
            }
        }

        if (letters.length) typeLetter();
    }
</script>

<style>
    .typing-accessible {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
    }
</style>