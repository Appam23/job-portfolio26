---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <section class="hero">
        <div class="hero-content">
            <p class="eyebrow">WEB DESIGN & DEVELOPMENT</p>

            <h1>
                Thoughtful design.<br />
                Practical development.
            </h1>

            <p class="hero-description">
                I’m Leihaopam Leisan, a Web Design and Development
                student at BYU–Idaho. I build responsive websites
                and update WordPress sites, bringing care to
                content, layout, and usability.
            </p>

            <div class="hero-actions">
                <a class="button button-primary" href="#projects">
                    Explore My Projects →
                </a>

                <a
                    class="button button-secondary"
                    href="https://github.com/Appam23"
                >
                    View GitHub ↗
                </a>
				<a
					class="button button-secondary"
					href="/resume.pdf"
					download="Leihaopam_Leisan_Resume.pdf"
				>
					Download Resume ↓
				</a>
            </div>

            <p class="hero-note">
                Expected graduation: July 2027
            </p>
        </div>
		<div class="hero-media">
    <img
        class="profile-photo"
        src="/Me.png"
        alt="Leihaopam Leisan"
    />

    <div class="hero-visual" aria-hidden="true">
        <div class="browser-bar">
            <span></span>
            <span></span>
            <span></span>
        </div>
	

        <div class="code-preview">
            <p class="code-comment">// Built with purpose</p>
            <p><span>const</span> developer = &#123;</p>
            <p class="code-indent">name: "Leihaopam",</p>
            <p class="code-indent">focus: "Accessible experiences",</p>
            <p class="code-indent">approach: "Keep learning"</p>
            <p>&#125;;</p>
        </div>

        <div class="visual-label">
            DESIGN → DEVELOP → REFINE
        </div>
    	</div>
	</div>
	</section>

    <section class="section" id="projects">
        <div class="section-heading">
            <p class="eyebrow">SELECTED WORK</p>
            <h2>Projects with purpose.</h2>
            <p>
                Personal projects and professional website contributions.
            </p>
        </div>

        <div class="project-grid">
            <article class="project-card">
                <div class="project-visual culture-visual">
                    <span>01 / CULTURAL HERITAGE</span>
                    <h3>Tangkhul Culture</h3>
                </div>

                <div class="project-content">
                    <p class="project-tags">HTML · CSS · JavaScript</p>
                    <h3>Sharing cultural heritage online</h3>
                    <p>
                        A website presenting Tangkhul traditions,
                        language, food, music, and natural heritage.
                    </p>
                    <a
                        class="text-link"
                        href="https://appam23.github.io/Tangkhul_Culture/"
                    >
                        Visit Tangkhul Culture ↗
                    </a>
                </div>
            </article>

            <article class="project-card">
                <div class="project-visual wordpress-visual">
                    <span>02 / PROFESSIONAL CONTRIBUTIONS</span>
                    <h3>WordPress Websites</h3>
                </div>

                <div class="project-content">
                    <p class="project-tags">WordPress · Content · Page Design</p>
                    <h3>Supporting live websites</h3>
                    <p>
                        Website updates for Sandhill Media Group,
                        including ICON Gaming, Radio Hex,
                        and Score Medicare.
                    </p>
                    <a class="text-link" href="#experience">
                        Explore My Contributions →
                    </a>
                </div>
            </article>
        </div>
    </section>

    <section class="section" id="skills">
        <div class="section-heading">
            <p class="eyebrow">MY TOOLKIT</p>
            <h2>Skills I’m building with.</h2>
        </div>

        <div class="skills-grid">
            <article class="skill-card">
                <h3>Frontend</h3>
                <p>HTML, CSS, JavaScript, responsive layouts, and Astro.</p>
            </article>

            <article class="skill-card">
                <h3>WordPress</h3>
                <p>Content editing, page layouts, and website maintenance.</p>
            </article>

            <article class="skill-card">
                <h3>Development Tools</h3>
                <p>Git, GitHub, VS Code, and Netlify.</p>
            </article>
        </div>
    </section>

    <section class="section experience-section" id="experience">
        <div class="section-heading">
            <p class="eyebrow">PROFESSIONAL EXPERIENCE</p>
            <h2>Working on real websites.</h2>
        </div>

        <article class="experience-card">
            <h3>Sandhill Media Group</h3>
            <p>
                I contribute to website updates, content editing,
                page design, and ongoing maintenance.
            </p>

            <ul>
                <li>
                    <a href="https://icongaming.us/">ICON Gaming</a>
                    — page design, layout improvements, and content updates.
                </li>
                <li>
                    <a href="https://radiohex.com/">Radio Hex</a>
                    — event listings and website content updates.
                </li>
                <li>
                    <a href="https://scoremedicare.com/">Score Medicare</a>
                    — page and content updates.
                </li>
            </ul>
        </article>
    </section>

    <section class="contact-section" id="contact">
        <p class="eyebrow">LET’S CONNECT</p>
        <h2>Have a role or project in mind?</h2>
        <p>
            I’d welcome a conversation about web development
            opportunities and how I could contribute.
        </p>

        <div class="hero-actions">
			<a class="button button-primary" href="/contact">
				Contact Me →
			</a>

            <a
                class="button button-secondary"
                href="https://www.linkedin.com/in/leisan23/"
            >
                Connect on LinkedIn ↗
            </a>
        </div>
    </section>
</Layout>